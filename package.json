{
  "name": "mesh-applause",
  "version": "0.1.1",
  "description": "Peer-to-peer mesh: anonymous kudos wall. Send appreciations to teammates; reveal at standup. Replaces Bonusly, Awardco.",
  "type": "module",
  "private": false,
  "homepage": "https://baditaflorin.github.io/mesh-applause/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baditaflorin/mesh-applause.git"
  },
  "bugs": {
    "url": "https://github.com/baditaflorin/mesh-applause/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bash scripts/build-pages.sh",
    "preview": "vite preview --host 0.0.0.0",
    "pages-preview": "vite preview --host 0.0.0.0 --port 4174",
    "test": "npm run test:unit && npm run test:e2e",
    "smoke": "bash scripts/smoke.sh",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "screenshot": "bash ../mesh-common/scripts/screenshot-app.sh",
    "demo": "bash ../mesh-common/scripts/record-demo.sh",
    "audit:security": "bash ../mesh-common/scripts/audit-app-security.sh",
    "test:leak": "MESH_RUN_LEAK_TEST=1 playwright test tests/e2e/memory-leak.spec.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-webrtc": "^10.3.0",
    "yjs": "13.6.30",
    "@baditaflorin/mesh-common": "file:../mesh-common"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
